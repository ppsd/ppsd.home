# ค่าเชื่อมต่อ Supabase สำหรับ migrate-supabase.bat — ก๊อปไฟล์นี้ไปไว้ที่ server\data\supabase.env แล้วใส่ค่าจริง
# (server\data\supabase.env ไม่ถูกส่งขึ้น git)

# Supabase Dashboard → ปุ่ม Connect → Connection String → Session pooler (พอร์ต 5432) แทน [YOUR-PASSWORD] ด้วยรหัสผ่าน DB
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Project Settings → API → Project URL และ service_role key (ใช้อัปโหลดไฟล์แนบขึ้น Storage)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ชื่อ bucket สำหรับไฟล์แนบ (สร้างให้เองถ้ายังไม่มี · private)
SUPABASE_BUCKET=ppsd-files
