{
  "name": "ppsd-erp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node server/index.js\" \"vite\"",
    "dev:web": "vite",
    "server": "node server/index.js",
    "build": "tsc && vite build",
    "start": "npm run build && node server/index.js",
    "test": "node --test server/tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "playwright-core": "^1.63.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^10.0.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
